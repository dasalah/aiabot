# Telegram API credentials (get from https://my.telegram.org)
API_ID=12345678
API_HASH=your_api_hash_here

# Bot token (get from @BotFather)
BOT_TOKEN=your_bot_token_here

# Bot username (without @, e.g. mybot)
BOT_USERNAME=your_bot_username

# Superadmin Telegram IDs (comma-separated)
SUPERADMIN_IDS=123456789,987654321

# Web admin panel
WEB_SECRET_KEY=change_this_to_a_random_secret_key
WEB_ADMIN_PASSWORD=change_this_password

# Required channels (comma-separated, with or without @)
REQUIRED_CHANNELS=@channel1,@channel2

# Optional: Custom config paths
# CONFIG_DIR=config
# DATA_DIR=data
